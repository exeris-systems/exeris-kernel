<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Exeris PMD Ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        Strict PMD ruleset for Exeris Java 26 projects enforcing Glass Box principles.
        Rules detect Java anti-patterns, code complexity, and architectural violations.
        Compatible with PMD 7.21.0+
    </description>

    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml">
        <!--
            ARCH-DECISION: Zero-Copy Glass-Box Contract.
            ExerisKernelException.rawArgs() deliberately returns the internal array
            by reference to guarantee zero allocation on the telemetry hot-path.
            A defensive copy would violate the "No Waste Compute" mandate.
            See: docs/subsystems/telemetry.md § "The Glass-Box Pattern"
        -->
        <exclude name="MethodReturnsInternalArray"/>
    </rule>

    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="OnlyOneReturn"/>
        <exclude name="TooManyStaticImports"/>
        <!--
            ARCH-DECISION: Descriptive names are non-negotiable in kernel SPI.
            Names like networkOffHeapThreshold, peakAllocatedBytes, CARRIER_INDEX
            encode domain semantics that abbreviated names would destroy. Kernel APIs
            are read far more often than written; clarity outweighs character count.
            ShortVariable is intentionally NOT excluded: overly short names (< 3 chars)
            offer no domain clarity and are banned in public SPI. If a local variable
            legitimately needs a short name (e.g. loop index `i`), suppress locally
            with @SuppressWarnings("PMD.ShortVariable") and a justification comment.
        -->
        <exclude name="LongVariable"/>
        <!--
            ARCH-DECISION: Pattern-matching instanceof with explicit primitive/widening cast.
            Kernel call sites sometimes rely on explicit primitive casts after pattern
            matching (for example, widening an Integer to long) to make the numeric
            contract and range semantics obvious and stable over time.
            PMD's UnnecessaryCast rule treats these casts as noise, but for Exeris
            they are part of the documented API surface and are therefore allowed.
        -->
        <exclude name="UnnecessaryCast"/>
    </rule>

    <!-- Design -->
    <rule ref="category/java/design.xml">
        <exclude name="LoosePackageCoupling"/>
        <!-- NcssCount replaces old Excessive*Length rules in PMD 7.19.0 -->
        <exclude name="ExcessivePublicCount"/>
        <!--
            ARCH-DECISION: Constant registries and value carriers are intentional.
            KernelErrorCodes is a pure constant registry (by design, WOC=0).
            ExerisKernelException is a structured value carrier for binary telemetry —
            accessor methods are part of the Glass-Box contract, not a sign of missing
            behaviour. The DataClass rule was designed to flag anemic domain models in
            business logic, not SPI-layer telemetry infrastructure.
        -->
        <exclude name="DataClass"/>
    </rule>

    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml">
        <!--
            ARCH-DECISION: Binary Glass-Box serialization replaces Java Serializable.
            Exeris kernel exceptions are serialised via the off-heap binary Glass-Box
            format (MemorySegment structs), never via java.io.ObjectOutputStream.
            Adding serialVersionUID would be pure ceremony with no runtime benefit.
            See: docs/subsystems/telemetry.md § "Binary Struct Mapping"
        -->
        <exclude name="MissingSerialVersionUID"/>
        <!--
            ARCH-DECISION: Record-style accessors (Java 26 / Valhalla-readiness).
            SPI types use accessor names without a "get" prefix (e.g. errorCode(),
            traceId(), sizeBytes()). This matches java.lang.Record conventions and
            prepares the codebase for value class / value record migration (JEP 401).
            PMD's AvoidFieldNameMatchingMethodName was designed for Java-8-era getters
            where a field "foo" and method "foo()" would be ambiguous. In record-style
            classes the method IS the canonical accessor for the field — by design.
        -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>
    </rule>

    <!-- Performance -->
    <rule ref="category/java/performance.xml"/>

    <!-- Security -->
    <rule ref="category/java/security.xml"/>

    <!-- Exeris-specific rules: Enforce NcssCount for class/method sizes -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <!-- Warn if method has >60 statements -->
            <property name="methodReportLevel" value="60"/>
            <!-- Warn if class has >1000 statements -->
            <property name="classReportLevel" value="1000"/>
        </properties>
    </rule>

    <!-- Exeris-specific rules: Cyclomatic Complexity -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="30"/>
            <property name="methodReportLevel" value="10"/>
        </properties>
    </rule>

    <!--
        ARCH-DECISION: Skomentowane puste bloki catch są dozwolone.
        Kernel code frequently has intentional no-op catch blocks for best-effort cleanup
        (e.g., Arena.close() during release, SSL_free during shutdown) where propagating
        the exception would be worse than silently accepting the failure.
        A mandatory comment explains the architectural intent.
        Unnamed variable _ (Java 22+ JEP 456) is also accepted.
    -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="true"/>
            <property name="allowExceptionNameRegex" value="^(_|ignored|expected)$"/>
        </properties>
    </rule>

</ruleset>

