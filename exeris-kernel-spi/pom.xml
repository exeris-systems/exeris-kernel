<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-kernel-parent</artifactId>
        <version>0.12.0</version>
        <relativePath>../exeris-kernel-parent/pom.xml</relativePath>
    </parent>

    <artifactId>exeris-kernel-spi</artifactId>
    <name>Exeris Kernel :: SPI</name>
    <description>The "Invisible Wall" — agnostic L0/L1/L2 contracts and RAII memory protocols.</description>
    <url>https://github.com/exeris-systems/exeris-kernel</url>

    <properties>
        <exeris.module.name>eu.exeris.kernel.spi</exeris.module.name>
        <!--
            v0.8 Sprint 6 (Coverage C-P0-01): LINE coverage floor for the SPI bundle.
            Current measurement: ~36% (records / enums / interface skeletons inflate
            the denominator). Ratchet at 0.30 — regressions blocked, headroom for
            organic improvement.
        -->
        <jacoco.line.minimum>0.30</jacoco.line.minimum>
        <!-- BRANCH baseline after the Phase 3 SPI carrier/enum tests: 30.0% (230/766),
             up from 22.1%. Ratchet ~8 pp below. -->
        <jacoco.branch.minimum>0.22</jacoco.branch.minimum>
    </properties>

    <dependencies>
        <!--
            Zero-Magic Test Guard (Architectural Mandate):
            Only JUnit 5 + AssertJ are permitted here.
            Mockito is EXPLICITLY EXCLUDED — all test doubles are hand-written
            anonymous implementations to enforce the "No Reflection" rule and
            ensure tests remain valid after Valhalla migration to value records.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            The Javadoc gate - ADR-085 SS-F.21, run by .github/workflows/guardrails.yml, never by a
            normal build.

            It lives in THIS pom and not the root one, and that is not cosmetic. The gate invokes
            `mvn -pl exeris-kernel-spi -am javadoc:javadoc`, and `-am` pulls every dependency into
            the reactor. From the root pom the profile applied to them too, so the first CI run
            failed on `exeris-kernel-build-config` - a module nobody meant to gate - and never
            reached the SPI at all. javadoc-conventions.md gates named modules; so does this.

            It is a profile and not a change to the `release` block in the root pom, deliberately.
            That block keeps `doclint none` and `failOnError false` because the ability to publish
            must not depend on the state of the prose: the comment there calls tightening it
            "quality work with its own slice", and this is that slice, held separately so a red gate
            never stops a release from being cut.

            Measured before switching on, on this module: 62 doclint errors and 100 warnings. The
            gate is therefore expected to be red on the day it lands, and that is the point - it is
            the worklist, and it is a reported check rather than a required one until the list is
            empty.

            The three custom tags are registered so the standard can be followed, NOT because the
            code follows it: across 276 sources here there is exactly one @apiNote, no @implSpec and
            no @implNote. Unregistered, that single tag is itself a doclint error - which is how it
            was found - and every tag added by rule 6 of javadoc-conventions.md would be another.
            Registering them makes writing the tags possible; writing them is L2 work no gate
            measures.

            The preview flag from the bundle's port target is deliberately absent: this line dropped
            preview from the whole build (see the MAVEN_OPTS comment in maven.yml), and javadoc
            accepts that flag only when `-source` equals the running JDK.
        -->
        <profile>
            <id>javadoc-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>all</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <failOnError>true</failOnError>
                            <quiet>false</quiet>
                            <tags>
                                <tag><name>apiNote</name><placement>a</placement><head>API Note:</head></tag>
                                <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
                                <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
                            </tags>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
