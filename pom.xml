<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris</groupId>
    <artifactId>exeris-kernel-root</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Kernel :: Root</name>
    <description>Cloud-Native, Zero-Copy Runtime Platform for the JVM (JDK 25 LTS, Panama FFM, Open-Core)</description>

    <!--
        v0.12 — url / organization / developers / scm are Maven Central publication requirements,
        validated per artifact rather than per reactor, and none of them existed here before.

        Inherited url and scm values have the child's artifactId APPENDED by default, which would
        publish ten POMs each pointing at a path that does not exist — and Maven Central shows the
        project URL on the artifact page an evaluator lands on, so "present but 404" is visible
        rather than cosmetic. The documented fix is `child.*.inherit.append.path="false"`.

        Measured rather than trusted, on Maven 3.9.12 against an isolated two-POM reproduction:
        `child.scm.connection.inherit.append.path` WORKS — the connection appends the child's
        artifactId without it and does not with it — while `child.project.url.inherit.append.path`
        has NO effect, appending either way. So the scm attributes below are load-bearing and stay,
        and the url attribute is not used at all: every module declares `<url>` explicitly instead,
        which is verbatim by construction and needs no attribute to behave.
    -->
    <url>https://github.com/exeris-systems/exeris-kernel</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://github.com/exeris-systems</url>
    </organization>

    <!--
        v0.12 — declared HERE rather than in exeris-kernel-parent, where it lived until now.
        Two published coordinates parent to this POM and not to that one — exeris-kernel-bom and
        exeris-kernel-build-config — so their effective POMs carried NO licence declaration at all
        while every other module inherited one. Verified with `help:effective-pom`, not assumed:
        `<licenses>` resolved 1 for spi and 0 for both of those.

        That is a licensing gap on its own (a published artifact that states no licence), and it
        is also the exact thing Maven Central validates per artifact rather than per reactor.
        Declaring it at the root is what makes the claim in LICENSING.md true of all ten
        coordinates instead of eight.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>
                The Exeris Kernel open-core sources are distributed under the unmodified
                Apache License, Version 2.0 — SPDX identifier "Apache-2.0". See LICENSE in
                the repository root for the full text and LICENSING.md for the open-core map.
                Apache-2.0 section 6 grants no trademark rights; TRADEMARK.md states the
                policy that governs use of the name.
            </comments>
        </license>
    </licenses>

    <!--
        Central requires at least one developer entry. It names the person because that is what the
        element is for — a point of contact and the party behind the coordinate — while NOTICE and
        the per-file headers name the project. TRADEMARK.md and CONTRIBUTING.md state the same
        split and the reason for it: a licence and a trademark are granted to a person, a copyright
        notice identifies a work's origin.
    -->
    <developers>
        <developer>
            <id>aprzychocki</id>
            <name>Arkadiusz Przychocki</name>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://github.com/exeris-systems</organizationUrl>
            <roles>
                <role>Founder</role>
                <role>Lead Architect</role>
            </roles>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/exeris-systems/exeris-kernel.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-kernel.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-kernel</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>exeris-kernel-build-config</module>
        <module>exeris-kernel-bom</module>
        <module>exeris-kernel-parent</module>

        <module>exeris-kernel-spi</module>
        <module>exeris-kernel-tck</module>
        <module>exeris-kernel-core</module>
        <module>exeris-kernel-community-testkit</module>
        <module>exeris-kernel-community</module>
        <module>exeris-kernel-community-kafka</module>
        <module>exeris-kernel-diagnostics-cli</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <!--
            ADR-066: the DISTRIBUTED artifact is preview-clean, so main sources compile without
            this flag. Test and TCK fixtures still use StructuredTaskScope (26 files) and are not
            distributed, so it is applied to the test-compile execution only, and to the surefire
            JVM below because preview-stamped test classes will not load without it.
        -->
        <jdk.preview.enable>--enable-preview</jdk.preview.enable>
        <coverage.argLine/>

        <!--
            v0.8 Sprint 6 (Coverage C-P0-01): default JaCoCo LINE coverage floor
            applied to every module that produces a jacoco.exec. Per-module
            overrides live in each module's <properties>. Default (0.20) is a
            floor that any module with source must meet; modules without their
            own tests (tck, community-testkit) skip the check naturally because
            no jacoco.exec is produced.
        -->
        <jacoco.line.minimum>0.20</jacoco.line.minimum>

        <!--
            v0.9 Sprint 4c Phase 3 (coverage mechanics): BRANCH coverage floor,
            previously unguarded (the v0.8 audit's blind spot — line could hold
            while branch silently rotted). Same ratchet model as LINE: per-module
            overrides sit ~5-9 pp below the measured 2026-06-10 baseline so the
            existing suite passes while a regression trips the gate. Branch ratios
            run lower than line, hence a lower default. Modules with no jacoco.exec
            (tck, community-testkit) skip the check; the thin diagnostics-cli is
            deliberately ungated (0.0) like its LINE floor.
        -->
        <jacoco.branch.minimum>0.15</jacoco.branch.minimum>
        <jvm.args>
            -XX:+UnlockExperimentalVMOptions
            -XX:+UseZGC
            -XX:-ZUncommit
            --enable-preview
            --enable-native-access=ALL-UNNAMED
            -XX:FlightRecorderOptions=stackdepth=256
            -XX:StartFlightRecording=disk=true,filename=target/surefire.jfr,maxsize=256m,maxage=10m,settings=profile
            -Xlog:jfr+startup=off
        </jvm.args>
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>

        <!--
            v0.12 Stream B — reproducible builds. Every Maven plugin that writes an archive reads
            this property and normalises entry timestamps and entry order to it instead of to the
            wall clock. Without it two builds of the same commit differ in every jar's bytes, so
            "this artifact was built from this source" is a claim only the builder can check —
            which is precisely the class of report SECURITY.md solicits ("release artifacts that
            cannot be traced back to source").

            It is also a PREREQUISITE, not a companion, for the SBOM below: an SBOM that describes
            an artifact nobody else can rebuild identically documents a jar rather than attesting
            to one.

            Bump at each release cut (docs/release ritual). A stale value is not a defect: what
            makes the output reproducible is that the value is FIXED, not that it is recent.
        -->
        <project.build.outputTimestamp>2026-08-26T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                    <executions>
                        <execution>
                            <id>default-testCompile</id>
                            <configuration>
                                <compilerArgs>
                                    <arg>${jdk.preview.enable}</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <argLine>@{coverage.argLine} ${jvm.args}</argLine>
                        <systemPropertyVariables>
                            <!--
                              A test that hangs is worse than a test that fails: it holds the build
                              open with no message, and CI reports a timeout on the job rather than a
                              name. This repository tests concurrency primitives, so several suites
                              wait on a latch whose only other exit is an interrupt from the very
                              teardown they are checking — StructuredScopeTest's neverReleased is the
                              clearest case, and the regression named in its own @DisplayName would
                              hang it rather than fail it. Nothing bounded them: no @Timeout on those
                              methods, no forkedProcessTimeoutInSeconds here or in any parent.
                              Ten minutes is far above any test in the reactor and far below "never".
                            -->
                            <junit.jupiter.execution.timeout.default>10 m</junit.jupiter.execution.timeout.default>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!--
                    v0.12 Stream B — pin the default-lifecycle plugins. Until now these carried no
                    version anywhere in the reactor, so their versions came from whichever Maven's
                    super-POM was on the machine: Maven 3.9.12 resolves maven-jar-plugin to 3.1.2,
                    a release that predates reproducible archive support entirely. So the pin is not
                    hygiene sitting next to the outputTimestamp property above — it is what makes
                    that property do anything, and a build on a different Maven would have silently
                    produced non-reproducible jars while the property sat there looking applied.

                    Pinning them also removes the last way the published bytes can change without a
                    commit changing.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                v0.12 Stream B — a CycloneDX SBOM is attached to every artifact this reactor
                publishes, with no exceptions to remember. The three pom-packaged modules (root,
                parent, bom) carry no code and get an SBOM with an empty component list, which is
                true rather than useful; that is a deliberate trade, because an exceptionless
                invariant ("every published coordinate has an SBOM beside it") is cheap to state in
                the release checklist and cheap to verify, while a list of exemptions rots.

                makeBom, not makeAggregateBom: a consumer resolves one coordinate, so the useful
                SBOM is the one describing what THAT jar carries. Maven attaches it under classifier
                `cyclonedx`, so `mvn deploy` publishes it beside the jar with no workflow change.

                includeBomSerialNumber is off because the serial is a fresh UUID per run and would
                make the SBOM the one output that never reproduces. Test scope is excluded: it is
                not in the distributed artifact, and listing it would overstate what a consumer
                actually resolves.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.1</version>
                <executions>
                    <execution>
                        <id>cyclonedx-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>json</outputFormat>
                    <includeBomSerialNumber>false</includeBomSerialNumber>
                    <!--
                        v0.12 S3 — defaults to TRUE, and that default silently removed the SBOM
                        from exactly the build that matters. `skipNotDeployed` skips the goal when
                        a module skips `deploy`, and central-publishing-maven-plugin declares
                        <extensions>true</extensions>, which sets `maven.deploy.skip` because it
                        replaces the deploy step with its own upload. So `mvn -P release verify`
                        produced eleven signed artifacts and ZERO SBOMs, while the CI SBOM gate —
                        which runs the ordinary build, where nothing skips deploy — stayed green.

                        A gate that is green about a path it does not cover is the failure mode
                        this whole stream exists to remove, so the release-readiness gate now
                        asserts the SBOM's presence and signature on the release build too.

                        Found by running `mvn -P release verify` against an ephemeral GPG key
                        rather than by assuming the two plugins compose.
                    -->
                    <skipNotDeployed>false</skipNotDeployed>
                    <!--
                        The scope set is written out even where it matches today's plugin
                        defaults. For an audit artifact, WHICH scopes an SBOM covers is a
                        decision someone should be able to read, and leaving it implicit would
                        let a future plugin default silently redefine what the published SBOM
                        claims. includeSystemScope is deliberately NOT among them: system scope
                        is a legacy Maven feature, `<scope>system</scope>` appears nowhere in
                        this reactor, and naming it would be stating a default about something
                        that does not exist.
                    -->
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.14</version>
                        <executions>
                            <execution>
                                <id>prepare-jacoco-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>coverage.argLine</propertyName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <formats>
                                        <format>XML</format>
                                        <format>HTML</format>
                                    </formats>
                                </configuration>
                            </execution>
                            <!--
                                v0.8 Sprint 6 (Coverage C-P0-01 absorption): enforce LINE
                                coverage floor per module. Each module-with-source sets its
                                own ${jacoco.line.minimum} in <properties> (ratchet pattern —
                                threshold slightly below current coverage so regressions are
                                caught while existing baseline passes). Modules without their
                                own tests (tck, community-testkit, parent, bom) produce no
                                jacoco.exec — the check goal then no-ops silently. The check
                                runs only when -Pcoverage is active (default CI main job).
                            -->
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.line.minimum}</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.branch.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                    <haltOnFailure>true</haltOnFailure>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            v0.12 Stream B S3 — everything a Maven Central release needs, and NOTHING that the
            ordinary build touches. Activated only by `-P release`.

            The isolation is not tidiness. central-publishing-maven-plugin declares
            <extensions>true</extensions>, which makes it TAKE OVER the `deploy` phase: declared
            outside this profile it would hijack the SNAPSHOT publish that every push to
            development/* performs against GitHub Packages, and the first symptom would be
            downstream consumers silently stopping to receive snapshots. So the two channels stay
            separate by construction — `mvn deploy` is GitHub Packages via <distributionManagement>,
            `mvn -P release deploy` is Central.

            OSSRH was shut down on 2025-06-30. nexus-staging-maven-plugin and the oss.sonatype.org
            URLs it needs no longer exist; anything describing that flow is describing a dead
            system.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central requires a sources jar for every published coordinate. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Central requires a javadoc jar to EXIST; it does not inspect its quality.
                        doclint is therefore off and failOnError false, deliberately and with the
                        cost stated: this tree currently has ~160 doclint findings across spi, core
                        and community (missing @param/@return, heading sequence), so a strict run
                        would block every release on documentation debt that no consumer is waiting
                        for. Measured before choosing, not assumed — with doclint off the jar builds
                        clean. Tightening this is quality work with its own slice; coupling it to
                        the ability to publish would be the wrong dependency.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>

                    <!--
                        Central verifies a detached GPG signature on every file it accepts — jar,
                        sources, javadoc and pom alike. The loopback pinentry argument is what lets
                        the passphrase arrive from the environment instead of a terminal prompt,
                        which is the difference between a release job that runs unattended and one
                        that hangs forever with no output.

                        maven-gpg-plugin 3.1.0+ reads MAVEN_GPG_PASSPHRASE from the ENVIRONMENT and
                        ignores the `gpg.passphrase` that actions/setup-java writes into
                        settings.xml. The release workflow therefore passes it as `env:` and does
                        NOT set setup-java's gpg-passphrase input.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>

                    <!--
                        autoPublish=false is not a placeholder to flip later without thinking. A
                        deployment sitting in the portal can be DROPPED; a published one cannot be
                        touched, ever. The first release goes through manual review of the portal's
                        validation results, and waitUntil=validated makes the build block until
                        there is something to review rather than exiting green on an upload.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!--
                                exeris-kernel-tck is held back from the first Central publication,
                                and the reason is a defect rather than a policy.

                                The module has only `src/test/` and no `src/main` at all, so its
                                published main jar contains 7 files and 4.6 kB of META-INF while
                                all 492 real classes ship under the `tests` classifier. Central
                                validates per artifact and requires a `-sources.jar` and a
                                `-javadoc.jar`; maven-source-plugin and maven-javadoc-plugin both
                                read the COMPILE source roots, which are empty here, so neither can
                                produce one. The plugins' `test-jar` goals emit `-test-sources.jar`,
                                a different classifier that does not satisfy the requirement.

                                The real fix is that the Abstract*Tck classes are this module's
                                published API and belong in `src/main` — which changes the
                                coordinate every provider module and the enterprise distribution
                                depend on, and is therefore its own slice, not a line in a signing
                                PR. Publishing an empty main jar to an immutable channel in the
                                meantime would be the worse of the two options.

                                Consumers keep resolving it from GitHub Packages exactly as today.
                                The release-readiness gate reads this list and reports what it
                                skipped, so the exclusion cannot quietly become permanent.
                            -->
                            <excludeArtifacts>
                                <excludeArtifact>exeris-kernel-tck</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <repository>
            <id>github-exeris-kernel</id>
            <name>Exeris Kernel — GitHub Packages</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
        </repository>
        <snapshotRepository>
            <id>github-exeris-kernel</id>
            <name>Exeris Kernel — GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
        </snapshotRepository>
    </distributionManagement>
</project>
