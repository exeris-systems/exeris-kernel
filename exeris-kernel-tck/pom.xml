<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-kernel-parent</artifactId>
        <version>0.12.0</version>
        <relativePath>../exeris-kernel-parent/pom.xml</relativePath>
    </parent>

    <artifactId>exeris-kernel-tck</artifactId>
    <name>Exeris Kernel :: TCK</name>
    <description>
        Technology Compatibility Kit: L1 unit tests, L2 integration tests, L3 system guarantees.
        Zero-GC JFR monitor, Panama Segfault Shield, Virtual Thread Avalanche, Bootstrap Matrix.
    </description>
    <url>https://github.com/exeris-systems/exeris-kernel</url>


    <properties>
        <!--
            This module's main sources are contract tests, and Sonar has to be told so explicitly:
            it keys production rules off sonar.sources alone, and the scanner derives that from the
            Maven source roots, which say src/main. Judging test code by production rules says so in
            its own words. The analysis taken right after these classes moved to src/main reported
            92 x java:S5960 "Remove this assertion from production code" and 9 x java:S5443 (a temp
            directory in a fixture) as CRITICAL vulnerabilities; all 115 new bugs and vulnerabilities
            on that run were in this one module, and all of them closed once it was classified as
            test code.

            sonar.sources is deliberately empty: there is no main source here to analyse as
            production. Both roots go to sonar.tests instead.
        -->
        <sonar.sources></sonar.sources>
        <sonar.tests>src/main/java,src/test/java</sonar.tests>

        <exeris.module.name>eu.exeris.kernel.tck</exeris.module.name>

        <!--
            This module's main sources are contract tests, so they are linted by rules written for
            contract tests. The delta from the kernel ruleset is a named list in
            pmd-ruleset-tck.xml, not a skip: 1782 PMD violations across 56 rules appeared the moment
            these classes became main sources, and every one was either excluded there with a reason
            or fixed in the code here.

            Checkstyle likewise, via checkstyle-tck.xml. Its 502 findings across 93 files were the
            same category mismatch — DeclarationOrder 180, LeftCurly 125, NeedBraces 60,
            MethodName 54, LineLength 53.

            Measured twice, because the first measurement measured nothing: PMD fails the build
            before Checkstyle runs, so an early "Checkstyle reports 0" was the absence of a run.
        -->

        <!--
            Coverage floors off, for the same reason and with the same shape as the two above. The
            root POM applies a default 0.20 line / 0.15 branch floor to every module that produces a
            jacoco.exec, ratcheted per module. This module now has 130 main classes exercised by its
            own 5 tests, because the other 125 are exercised by the PROVIDERS that subclass them, in
            other modules — which is what a TCK is. Measured against its own module the ratio is
            near zero, and it would be near zero however good the contract is.

            `exeris-kernel-diagnostics-cli` already sits at 0.0 with a stated reason, so a module
            declaring itself ungated is an established shape rather than a new escape hatch.
        -->
        <jacoco.line.minimum>0.0</jacoco.line.minimum>
        <jacoco.branch.minimum>0.0</jacoco.branch.minimum>
    </properties>

    <dependencies>
        <!-- SPI contracts — TCK tests only against interfaces, never implementations -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
        </dependency>

        <!--
            COMPILE scope, and the change of scope is the point of this module's shape.

            The Abstract*Tck classes are this module's published API: they are `abstract class`
            declarations carrying @Test methods that a provider subclasses. A consumer that extends
            one needs JUnit, AssertJ and Mockito on the same classpath to compile at all, so these
            are dependencies of the contract rather than of testing it. Declaring them `test` while
            the classes lived in src/test happened to work because nothing outside compiled against
            them; it stops being true the moment they are published.

            Consumers take this module at `test` scope themselves, so nothing here reaches anybody's
            runtime classpath.

            Versions are managed by the BOM (junit-bom import). The `compile` scope is stated
            explicitly rather than left out: exeris-kernel-parent manages every one of these at
            `test`, so an omitted scope inherits `test` and the module fails to compile with
            "package org.assertj.core.api does not exist" — measured, not guessed.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- JMH — the abstract benchmarks in perf/ are part of the published surface too. -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            ArchUnit stays `test`: the only class that uses it is ExerisArchitectureTest, which is
            this module's own test and remains in src/test. It is not part of what a provider
            subclasses.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                No `test-jar` execution any more, and its removal is what this change is for. The
                classifier-`tests` artefact used to carry all 492 real classes while the main jar
                held seven files of metadata; now the main jar holds the contract and src/test holds
                five self-tests that nobody consumes. Producing a test-jar of those five would
                publish a coordinate whose name promises the TCK and whose content is not it.

                Consumers therefore drop `<classifier>tests</classifier><type>test-jar</type>` and
                depend on the plain artefact at `test` scope. The out-of-repo enterprise
                distribution does the same, in lockstep.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <rulesets>
                        <ruleset>pmd-ruleset-tck.xml</ruleset>
                    </rulesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>checkstyle-tck.xml</configLocation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>
                        @{coverage.argLine}
                        --enable-native-access=ALL-UNNAMED
                        -XX:+UnlockExperimentalVMOptions
                        -XX:+UseZGC
                        -XX:-ZUncommit
                    </argLine>

                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <useSystemClassLoader>true</useSystemClassLoader>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The Javadoc gate - ADR-085 SS-F.21, run by .github/workflows/guardrails.yml, never by a
            normal build.

            It lives in THIS pom and not the root one, and that is not cosmetic. The gate invokes
            `mvn -pl <modules> -am javadoc:javadoc`, and `-am` pulls every dependency into the
            reactor. From the root pom the profile applied to them too, so the first CI run failed on
            `exeris-kernel-build-config` - a module nobody meant to gate - and never reached its
            target at all. javadoc-conventions.md gates named modules; so does this. The TCK is
            gated because it is a published contract surface that is neither Core, Community nor
            tooling, which is the set rule 11 sends to diff-aware checking instead.

            It is a profile and not a change to the `release` block in the root pom, deliberately.
            That block keeps `doclint none` and `failOnError false` because the ability to publish
            must not depend on the state of the prose: the comment there calls tightening it
            "quality work with its own slice", and this is that slice, held separately so a red gate
            never stops a release from being cut.

            Measured before switching on, on this module: 13 doclint errors and warnings capped at
            javadoc's default -Xmaxwarns of 100, so the warning figure is a floor. The
            gate is therefore expected to be red on the day it lands, and that is the point - it is
            the worklist, and it is a reported check rather than a required one until the list is
            empty.

            The three custom tags are registered so the standard can be followed, NOT because the
            code follows it. The SPI, measured, carries one @apiNote across 276 sources and neither of the
            other two; this module was not counted separately. Unregistered, that single tag is itself a doclint error - which is how it
            was found - and every tag added by rule 6 of javadoc-conventions.md would be another.
            Registering them makes writing the tags possible; writing them is L2 work no gate
            measures.

            The preview flag from the bundle's port target is deliberately absent: this line dropped
            preview from the whole build (see the MAVEN_OPTS comment in maven.yml), and javadoc
            accepts that flag only when `-source` equals the running JDK.
        -->
        <profile>
            <id>javadoc-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>all</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <failOnError>true</failOnError>
                            <quiet>false</quiet>
                            <tags>
                                <tag><name>apiNote</name><placement>a</placement><head>API Note:</head></tag>
                                <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
                                <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
                            </tags>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
