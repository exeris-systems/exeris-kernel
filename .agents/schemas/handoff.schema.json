          "enum": [
            "exeris-router",
            "exeris-architect",
            "exeris-implementer",
            "exeris-tck",
            "exeris-performance",
            "exeris-docs-adr",
            "exeris-evaluator"
          ]
        },
        "to": {
          "enum": [
            "exeris-router",
            "exeris-architect",
            "exeris-implementer",
            "exeris-tck",
            "exeris-performance",
            "exeris-docs-adr",
            "exeris-evaluator"
          ]
        }
      }
    }
  ]
}
