{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage result (exeris-kernel)",
  "description": "The bundle's shape, narrowed to this repository's task classes, roles and scope vocabulary. The required fields and the `validation_gates` contract — a gate is never named without the risk it retires — are the base's; only the vocabulary is local.",
  "allOf": [
    {
      "$ref": "../vendor/exeris-agents-1.3.1/schemas/triage-result.base.schema.json"
    },
    {
      "properties": {
        "task_class": {
          "enum": [
            "ARCHITECTURE",
            "IMPLEMENTATION",
            "CONTRACT_VERIFICATION",
            "PERFORMANCE_REVIEW",
            "DOCS_ADR",
            "MULTI_DOMAIN"
          ]
        },
        "primary_agent": {
          "enum": [
            "exeris-router",
            "exeris-architect",
            "exeris-implementer",
            "exeris-tck",
            "exeris-performance",
            "exeris-docs-adr",
            "exeris-evaluator"
          ]
        }
      }
    }
  ]
}
