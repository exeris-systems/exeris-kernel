<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.preview</groupId>
        <artifactId>exeris-kernel-parent</artifactId>
        <version>0.11.0</version>
        <relativePath>../exeris-kernel-parent/pom.xml</relativePath>
    </parent>

    <artifactId>exeris-kernel-community-testkit</artifactId>

    <name>Exeris Kernel :: Community Testkit</name>
    <description>Reusable fixtures that boot the real kernel for tests across modules and for downstream consumers.</description>

    <properties>
        <!--
            PREVIEW LINE ONLY — same reason as exeris-kernel-spi and exeris-kernel-core, now that
            this module carries a `value` modifier too: Checkstyle's Java grammar does not know the
            modifier and fails to PARSE the file, so it reports a configuration error rather than a
            style finding.

            The bar is not lowered, and the argument is the one this line already rests on
            (PREVIEW-TRACK.md: "never self-verifying ... that verification is always inherited from
            `main`"): these same sources, minus the modifier, are fully Checkstyle-gated on `main`
            over JDK 25. Nothing preview-only is left unchecked, because the delta IS the modifier.

            RE-ENABLE when Checkstyle's grammar accepts JEP 401. Test it by deleting this property
            and running `mvn -pl exeris-kernel-community-testkit checkstyle:check`.
        -->
        <checkstyle.skip>true</checkstyle.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris.preview</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris.preview</groupId>
            <artifactId>exeris-kernel-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>
        <!-- Version managed by exeris-kernel-bom; the previous hard-pinned 5.10.2 diverged from the
             reactor-wide JUnit and would have put two Jupiter versions on the test classpath. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
